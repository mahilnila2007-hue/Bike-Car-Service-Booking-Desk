# ================================================================
# Smart Garage Management System - Environment Variables Example
# ================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.

# Server
SERVER_PORT=8080
GARAGE_NAME=NEKA Garage

# Firebase Backend (Admin SDK)
# Path to your Firebase service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=classpath:firebase-service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Frontend (Web SDK) - These are PUBLIC, safe to expose in frontend
FIREBASE_WEB_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Billing
BILLING_TAX_PERCENTAGE=18.0
